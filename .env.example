# PostgreSQL local
DATABASE_URL="postgresql://shakemill@localhost:5432/communaute_bapa"

# Auth.js
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth — Google (console.cloud.google.com → APIs & Services → Credentials)
# Callback : {AUTH_URL}/api/auth/callback/google
# ACTIVE dès que ID + SECRET sont renseignés (redémarrer le serveur)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OAuth — Apple (developer.apple.com → Certificates, Identifiers & Profiles)
# Callback : {AUTH_URL}/api/auth/callback/apple
# Services ID (com.bapa-officiel.communaute), PAS App ID …communaute1
# AUTH_APPLE_SECRET = JWT eyJ… ; activer avec AUTH_APPLE_ENABLED=1
AUTH_APPLE_ENABLED=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# URL publique du sous-site
NEXT_PUBLIC_SITE_URL="https://communaute.bapa-officiel.com"

# SMTP (bapa-officiel.com)
SMTP_HOST=bapa-officiel.com
SMTP_PORT=465
SMTP_USER=bienvenue@bapa-officiel.com
SMTP_PASS=
SMTP_FROM="Communauté Bapa <bienvenue@bapa-officiel.com>"
# Mettre à false uniquement si le certificat SSL du serveur mail est invalide/expiré
SMTP_TLS_REJECT_UNAUTHORIZED=true

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_REGISTRATION=inscription_recue
WHATSAPP_TEMPLATE_TEMP_PASSWORD=mot_de_passe_temporaire
WHATSAPP_TEMPLATE_VALIDATED=compte_valide
WHATSAPP_TEMPLATE_REJECTED=compte_refuse
WHATSAPP_TEMPLATE_LANG=fr
